{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apicbase Ingredients Recipes API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://app.apicbase.com/oauth/authorize/",
      "accessTokenUrl": "https://api.apicbase.com/oauth/token/",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Recipes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get recipes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apicbase.com/api/v2/products/recipes/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated results."
              },
              {
                "name": "ordering",
                "value": "",
                "type": "query",
                "description": "Field to order results by."
              },
              {
                "name": "uid",
                "value": "",
                "type": "query",
                "description": "Filter by recipe UID."
              },
              {
                "name": "name",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of recipes in the active library."
        },
        {
          "info": {
            "name": "Create a recipe",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.apicbase.com/api/v2/products/recipes/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a recipe"
        }
      ]
    }
  ],
  "bundled": true
}